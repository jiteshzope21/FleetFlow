# ==========================================
# FleetFlow - Environment Variables Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Free Tier / Local Connection
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fleetflow?retryWrites=true&w=majority
# Example for local/in-memory fallback: mongodb://127.0.0.1:27017/fleetflow
MONGODB_URI=mongodb://127.0.0.1:27017/fleetflow

# Optional Custom DNS Resolver for Atlas SRV Resolution
# Set this if local router/ISP DNS rejects Node.js SRV queries (querySrv ECONNREFUSED)
# Options: '8.8.8.8,1.1.1.1' or 'google' or 'cloudflare'
DNS_SERVERS=

# JWT Authentication
JWT_SECRET=super_secret_fleetflow_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_fleetflow_refresh_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Super Admin Seed (Used by seed script only, not stored in source code)
SUPER_ADMIN_EMAIL=superadmin@fleetflow.local
SUPER_ADMIN_PASSWORD=FleetFlowAdmin2026!
SUPER_ADMIN_NAME=FleetFlow Platform Admin
