{
  "name": "fleetflow",
  "version": "1.0.0",
  "private": true,
  "description": "FleetFlow - AI-Powered Transport & Fleet Management System (Multi-tenant SaaS)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue.bold,cyan.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "server:dev": "npm run dev --workspace=server",
    "client:dev": "npm run dev --workspace=client",
    "server:test": "npm run test --workspace=server",
    "port:check": "node scripts/checkPort.cjs",
    "seed:admin": "npm run seed:admin --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
